{
  "manifest_version": 3,
  "name": "Clear Copy — Smart Web to PDF & Markdown",
  "version": "2.0.0",
  "description": "Turn any web page into a clean, readable document. Expands hidden content, collects pages or selections, and exports as PDF or Markdown.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "debugger",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Clear Copy",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "add-page": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Alt+Shift+C"
      },
      "description": "Add this page to the collection"
    },
    "add-selection": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Add the selected text to the collection"
    },
    "open-preview": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Alt+Shift+P"
      },
      "description": "Open the Clear Copy preview"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/*.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
